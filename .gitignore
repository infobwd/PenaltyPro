# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# ค่าเชื่อมต่อฐานข้อมูลและ secret ของ API — ห้าม commit เด็ดขาด
# ครอบทุกไฟล์ที่ขึ้นต้นด้วย config เพราะสำเนาที่ตั้งชื่อเอง (config-backup,
# configaaaa, config.old) มีรหัสฐานข้อมูลและ secret เต็ม ๆ เหมือนกัน
api/config*.php
!api/config.example.php

# ข้อมูลจริงจากการ migrate — มีรหัสผ่าน, เบอร์โทร, เลขผู้เสียภาษี, ที่อยู่ผู้บริจาค
# สร้างใหม่ได้ทุกเมื่อด้วย tools/etl/
db/seed/

# cache และไฟล์อัปโหลดที่ระบบสร้างเอง
storage/cache/*
storage/uploads/*
!storage/*/.gitignore
!storage/*/.htaccess

