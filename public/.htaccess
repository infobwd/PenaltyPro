# วางไฟล์นี้ไว้ที่ document root ของ kickoff.bwd.ac.th (ข้าง ๆ index.html)
# Vite คัดลอกไฟล์ใน public/ ไป dist/ ให้อัตโนมัติ

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── 1. รวม URL ให้เหลือรูปแบบเดียว ────────────────────────────────────
    # เข้าผ่าน www.kickoff... กับ kickoff... ถือเป็นคนละ origin ในสายตาเบราว์เซอร์
    # ทำให้ fetch ข้ามกันแล้วโดน CORS บล็อก และ service worker/PWA จะแยกกันคนละชุด
    # จึงบังคับให้เหลือ URL เดียวตั้งแต่ระดับเซิร์ฟเวอร์
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # ── 2. SPA fallback ───────────────────────────────────────────────────
    # ทุก path ที่ไม่ใช่ไฟล์จริงและไม่ใช่ /api/ ให้เสิร์ฟ index.html
    # เพื่อให้เปิดลิงก์ตรง เช่น /schedule แล้วไม่ 404
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/storage/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # index.html ห้ามถูกแคชนาน ไม่งั้นผู้ใช้ค้างอยู่กับ build เก่าที่ชี้ไฟล์ผิด
    <FilesMatch "^(index\.html|sw\.js|manifest\.json)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    # ไฟล์ใน assets/ มี hash ในชื่ออยู่แล้ว แคชยาวได้ปลอดภัย
    <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|gif|svg|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ห้ามรันสคริปต์ในโฟลเดอร์ที่เก็บไฟล์อัปโหลด
<IfModule mod_mime.c>
    <FilesMatch "\.(php|phtml|phar)$">
        <If "%{REQUEST_URI} =~ m#^/storage/#">
            Require all denied
        </If>
    </FilesMatch>
</IfModule>
